{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git worktree list": "allow",
      "git worktree add *": "allow",
      "git worktree remove *": "allow",
      "git worktree prune": "allow",
      "git checkout -b *": "allow",
      "git switch": "allow",
      "git switch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push": "allow",
      "git push *": "allow",
      "gh pr create *": "allow",
      "gh pr view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "git push origin main": "deny",
      "git push origin main *": "deny",
      "git push origin master": "deny",
      "git push origin master *": "deny",
      "git push * origin main": "deny",
      "git push * origin main *": "deny",
      "git push * origin master": "deny",
      "git push * origin master *": "deny"
    }
  }
}
