{
  "name": "voxkey",
  "productName": "VoxKey",
  "version": "0.4.0",
  "description": "VoxKey: on-screen keyboard with real-time voice typing for Windows and macOS",
  "license": "MIT",
  "author": {
    "name": "Eran Raichstein",
    "email": "eran.raichstein@gmail.com"
  },
  "homepage": "https://github.com/eranra/voxkey",
  "repository": {
    "type": "git",
    "url": "https://github.com/eranra/voxkey.git"
  },
  "bugs": {
    "url": "https://github.com/eranra/voxkey/issues"
  },
  "keywords": [
    "voxkey",
    "voice-typing",
    "on-screen-keyboard",
    "electron",
    "speech-to-text"
  ],
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/ensure-electron.js",
    "prestart": "node scripts/ensure-electron.js",
    "start": "electron .",
    "prestart:minimized": "node scripts/ensure-electron.js",
    "start:minimized": "electron . --minimized",
    "build:keyhelper": "node scripts/build-keyhelper.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "lint": "node scripts/check-syntax.js",
    "check": "npm run lint && npm test",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "icons": "node scripts/make-icons.js",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "build:injector": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /out:bin\\injector.exe native\\injector.cs",
    "build:keyhelper:win": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /out:bin\\keystate-windows.exe native\\keystate.cs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  }
}
