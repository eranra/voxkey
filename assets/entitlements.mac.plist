<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Needed by Electron's JavaScript engine under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Ad-hoc signed builds: allow Electron's own frameworks, which have a different (ad-hoc) signature. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Typing into other apps through System Events (osascript). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Voice typing. The hardened runtime denies audio input without this entitlement, silently
         and without any prompt: the microphone permission dialog never appeared, and VoxKey
         never showed up in the Microphone list. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
